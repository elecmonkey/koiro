# 跑 E2E 用的 koiro-server 环境变量；配合 docker-compose.yml 起的 postgres + localstack（S3 模拟）。
# 复制一份（比如 .env.e2e，已在 .gitignore 里），source 一下再 cargo run，
# 千万别覆盖仓库根目录给开发/生产用的 .env。
#
# KOIRO_BIND 用非默认端口：3721 大概率被你平时开发用的 koiro-server 占着，
# 这套 E2E 专用的后端不能抢那个端口，web 那边也要起第二份、代理到这里（见 README）。
KOIRO_BIND=127.0.0.1:3799
DATABASE_URL=postgresql://koiro:koiro@localhost:5434/koiro
AUTH_SECRET=e2e-test-secret-at-least-32-characters-long
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=koiro-e2e
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9090/koiro-e2e
KOIRO_COOKIE_SECURE=false

{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id AS \"id: PlaylistId\", p.name, p.description, p.cover_object_id, p.updated_at,\n                  (SELECT count(*) FROM song_playlists sp WHERE sp.playlist_id = p.id) AS \"song_count!\"\n           FROM playlists p WHERE p.name ILIKE $1 OR p.description ILIKE $1\n           ORDER BY p.updated_at DESC, p.id LIMIT $2 OFFSET $3",

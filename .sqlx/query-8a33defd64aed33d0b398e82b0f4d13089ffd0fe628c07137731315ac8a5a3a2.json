  "query": "SELECT s.id, s.title, av.name AS \"version?\"\n           FROM songs s LEFT JOIN audio_versions av ON av.song_id = s.id AND av.is_default\n           WHERE av.id IS NULL OR av.lyrics_id IS NULL\n           ORDER BY s.title",

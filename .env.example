# PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/koiro

# JWT 签名密钥（至少 32 字符，可用 `openssl rand -base64 32` 生成）；更换会让所有登录失效
AUTH_SECRET=

# 服务监听地址（默认 127.0.0.1:3721）
# KOIRO_BIND=127.0.0.1:3721
# 允许未登录用户浏览（1 / true）
# KOIRO_ALLOW_ANON=false
# 会话 cookie 是否带 Secure（默认 true；本地 http 调试且浏览器不认 localhost 时设 false）
# KOIRO_COOKIE_SECURE=true

# S3 兼容存储
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=my-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对象 key 前缀
S3_PREFIX=koiro/
# 公开读对象（<prefix>img/*）的访问前缀，可以是绑定到桶的自定义域名
S3_PUBLIC_URL=https://s3.example.com
# 默认 false（virtual-hosted 风格）；MinIO 等需要 path-style 时设为 true
# S3_FORCE_PATH_STYLE=false

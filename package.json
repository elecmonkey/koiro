{
  "name": "koiro",
  "version": "0.1.0",
  "description": "Koiro - 个人音乐库管理系统",
  "author": "Elecmonkey <elecmonkey@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/elecmonkey/koiro"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3720",
    "build": "pnpm -r run build && next build",
    "start": "next start -p 3720",
    "lint": "eslint",
    "prisma:generate": "pnpm --filter @koiro/db prisma:generate",
    "prisma:migrate": "pnpm --filter @koiro/db prisma:migrate",
    "prisma:studio": "pnpm --filter @koiro/db prisma:studio",
    "prisma:push": "pnpm --filter @koiro/db prisma:push",
    "auth:secret": "pnpx auth secret",
    "user:add": "tsx scripts/add-user.ts",
    "songs:dedupe": "tsx scripts/find-duplicate-songs.ts",
    "songs:missing-lyrics": "tsx scripts/find-missing-lyrics.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@koiro/db": "workspace:*",
    "@koiro/s3": "workspace:*",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@prisma/adapter-pg": "^7.4.1",
    "axios": "^1.13.6",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.0.2",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.2.1",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
}
